# PostgreSQL variables for Docker Compose (`db` service + interpolation for `api`).
# Copy to files next to this one:
#   cp .env.example .env.local
#   cp .env.example .env.production
# Then edit secrets. `.env.local` / `.env.production` are gitignored.

POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=pfi
