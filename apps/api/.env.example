# =============================================================================
# Example environment variables — maps to app.core.config.Settings
# Copy to .env.local (or the file your compose setup loads) and adjust per env
# =============================================================================

# Runtime environment: local | staging | production (code default: local)
ENVIRONMENT=local

# Service display name for logs / metadata (code default: pfi-api)
APP_NAME=pfi-api

# Debug mode: when true, SQLAlchemy echoes SQL (wired via settings.DEBUG in db.py)
DEBUG=false

# URL path prefix for mounting v1 routers (code default: /api/v1)
API_V1_PREFIX=/api/v1

# Database URL for SQLModel/SQLAlchemy (required — no default in code)
# Example assumes PostgreSQL from docker-compose service "db"; match infra/postgres credentials
DATABASE_URL=postgresql+psycopg://user:password@db:5432/pfi

# Secret for signing tokens (e.g. JWT). Use a long random value in production
SECRET_KEY=change-me-use-long-random-secret-in-production

# Token signing algorithm (code default: HS256)
ALGORITHM=HS256

# Token lifetime in seconds — e.g. 3600 = 1 hour (required — no default in code)
EXPIRE_TIME=3600
